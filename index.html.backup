<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>adaptive music player</title>
    <style>
        body {
            margin: 0;
            padding: 50px;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            overflow: hidden;
            position: relative;
            user-select: none
        }

        .login-screen {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, .9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            color: #fff
        }

        .login-button {
            background: #1db954;
            color: #fff;
            border: none;
            padding: 15px 30px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: .3s;
            margin-top: 20px
        }

        .login-button:hover {
            background: #1ed760
        }

        .track-info {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: #fff;
            text-align: center;
            font-size: 14px;
            max-width: 300px
        }

        .track-name {
            font-weight: 600;
            margin-bottom: 5px
        }

        .artist-name {
            opacity: .8;
            font-size: 12px
        }

        .space-background {
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at bottom, #1B2735 0%, #090A0F 100%);
            z-index: -2
        }

        .stars {
            position: fixed;
            inset: 0;
            z-index: -1
        }

        .star {
            position: absolute;
            background: #fff;
            border-radius: 50%;
            animation: twinkle 2s infinite
        }

        .star.small {
            width: 1px;
            height: 1px
        }

        .star.medium {
            width: 2px;
            height: 2px
        }

        .star.large {
            width: 3px;
            height: 3px
        }

        @keyframes twinkle {

            0%,
            100% {
                opacity: .3
            }

            50% {
                opacity: 1
            }
        }

        .dust {
            position: absolute;
            background: rgba(255, 255, 255, .1);
            border-radius: 50%;
            animation: float 10s infinite linear
        }

        @keyframes float {
            0% {
                transform: translateY(100vh) translateX(0)
            }

            100% {
                transform: translateY(-100px) translateX(50px)
            }
        }

        /* ✅ 드래그용 래퍼: transform 대신 left/top으로 이동 */
        .ipod-wrapper {
            position: fixed;
            /* 화면 위 자유롭게 이동 */
            left: calc(50% - 60px);
            top: calc(50% - 60px);
            /* 중앙 시작 (120x120 기준) */
            width: 120px;
            height: 120px;
            z-index: 1;
            cursor: grab;
            /* 드래그 중 포인터 시각 */
        }

        .ipod-wrapper.dragging {
            cursor: grabbing
        }

        .ipod-container {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #d5d5d5 0%, #b8b8b8 50%, #a8a8a8 100%);
            border-radius: 6px;
            box-shadow: 0 5px 12px rgba(0, 0, 0, .3), inset 0 1px 0 rgba(255, 255, 255, .6), inset 0 -1px 0 rgba(0, 0, 0, .3);
            display: flex;
            justify-content: center;
            align-items: center;
            animation: floatTilt 4s ease-in-out infinite;
            user-select: none
        }

        .ipod-container.playing {
            animation: playingPulse 2s ease-in-out infinite
        }

        .ipod-container.similar-mode {
            box-shadow: 0 5px 12px rgba(0, 0, 0, .3), 0 0 20px rgba(34, 197, 94, .6);
            animation: similarGlow 2s ease-in-out infinite
        }

        .ipod-container.diverse-mode {
            box-shadow: 0 5px 12px rgba(0, 0, 0, .3), 0 0 20px rgba(239, 68, 68, .6);
            animation: diverseGlow 2s ease-in-out infinite
        }

        @keyframes similarGlow {

            0%,
            100% {
                box-shadow: 0 5px 12px rgba(0, 0, 0, .3), 0 0 15px rgba(34, 197, 94, .4)
            }

            50% {
                box-shadow: 0 8px 20px rgba(0, 0, 0, .4), 0 0 25px rgba(34, 197, 94, .8)
            }
        }

        @keyframes diverseGlow {

            0%,
            100% {
                box-shadow: 0 5px 12px rgba(0, 0, 0, .3), 0 0 15px rgba(239, 68, 68, .4)
            }

            50% {
                box-shadow: 0 8px 20px rgba(0, 0, 0, .4), 0 0 25px rgba(239, 68, 68, .8)
            }
        }

        @keyframes playingPulse {

            0%,
            100% {
                transform: scale(1) rotate(0);
                box-shadow: 0 5px 12px rgba(0, 0, 0, .3), 0 0 0 rgba(29, 185, 84, 0)
            }

            50% {
                transform: scale(1.05) rotate(1deg);
                box-shadow: 0 8px 20px rgba(0, 0, 0, .4), 0 0 20px rgba(29, 185, 84, .3)
            }
        }

        @keyframes floatTilt {
            0% {
                transform: rotate(0) translateY(0)
            }

            25% {
                transform: rotate(2deg) translateY(-3px)
            }

            50% {
                transform: rotate(-1deg) translateY(-6px)
            }

            75% {
                transform: rotate(1.5deg) translateY(-3px)
            }

            100% {
                transform: rotate(0) translateY(0)
            }
        }

        .clickwheel {
            width: 90px;
            height: 90px;
            background: radial-gradient(circle, #1a1a1a 0%, #0a0a0a 70%, #000 100%);
            border-radius: 50%;
            position: relative;
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, .8), 0 2px 3px rgba(0, 0, 0, .4)
        }

        .center-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #e5e5e5 0%, #c8c8c8 50%, #b8b8b8 100%);
            border: 1px solid #999;
            border-radius: 50%;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .3), inset 0 1px 0 rgba(255, 255, 255, .8), inset 0 -1px 0 rgba(0, 0, 0, .1);
            cursor: pointer;
            transition: transform .1s ease
        }

        .control {
            position: absolute;
            color: #ccc;
            font-size: 12px;
            font-weight: 400;
            user-select: none;
            cursor: pointer;
            transition: .2s;
            font-family: Arial, sans-serif
        }

        .control:hover {
            color: #fff
        }

        .control.active {
            color: #1db954 !important
        }

        .volume-up {
            top: 5px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 14px
        }

        .volume-down {
            bottom: 5px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 14px
        }

        .prev {
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            font-weight: bold
        }

        .next {
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            font-weight: bold
        }

        .play-pause {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #2d2d2d;
            font-size: 18px;
            pointer-events: none;
            font-weight: bold;
            text-shadow: 0 1px 1px rgba(0, 0, 0, .3);
            font-family: Arial, sans-serif
        }

        .hidden {
            display: none !important
        }

        .error-message {
            color: #ff6b6b;
            text-align: center;
            margin-top: 20px
        }

        .github-link {
            position: fixed;
            top: 20px;
            right: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: #fff;
            text-decoration: none;
            background: rgba(255, 255, 255, .1);
            padding: 10px 15px;
            border-radius: 20px;
            font-size: 14px;
            transition: .3s;
            border: 1px solid rgba(255, 255, 255, .2);
            backdrop-filter: blur(10px)
        }

        .github-link:hover {
            background: rgba(255, 255, 255, .2);
            transform: translateY(-2px);
            color: #fff
        }

        .search-interface {
            position: absolute;
            top: 50px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, .9);
            padding: 30px;
            border-radius: 15px;
            color: #fff;
            text-align: center;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .5);
            border: 1px solid rgba(255, 255, 255, .1);
            backdrop-filter: blur(10px)
        }

        .search-input {
            width: 90%;
            padding: 10px 16px;
            /* 기존 16px 24px → 줄임 */
            margin: 8px 0;
            /* 위아래 여백 줄임 */
            border: 2px solid rgba(255, 255, 255, .3);
            border-radius: 20px;
            /* 기존 30px → 줄여서 컴팩트하게 */
            background: rgba(255, 255, 255, .1);
            color: #fff;
            font-size: 14px;
            /* 기존 18px → 줄임 */
            outline: none;
            transition: .3s;
        }

        .search-input:focus {
            border-color: #1db954;
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, .6);
            font-size: 13px;
            /* placeholder도 조금 줄임 */
        }

        .search-input:focus {
            border-color: #1db954
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, .6)
        }

        .search-button {
            background: #1db954;
            color: #fff;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: .3s;
            margin: 0 5px
        }

        .search-button:hover {
            background: #1ed760
        }

        .search-button:disabled {
            background: #666;
            cursor: not-allowed
        }

        .recommendation-list {
            margin-top: 20px;
            max-height: 300px;
            overflow-y: auto;
            text-align: left
        }

        .recommendation-item {
            background: rgba(255, 255, 255, .1);
            margin: 10px 0;
            padding: 15px;
            border-radius: 10px;
            cursor: pointer;
            transition: .3s;
            border: 1px solid rgba(255, 255, 255, .1)
        }

        .recommendation-item:hover {
            background: rgba(255, 255, 255, .2)
        }

        .recommendation-item.selected {
            background: rgba(29, 185, 84, .3);
            border-color: #1db954
        }

        .rec-title {
            font-weight: 600;
            color: #fff;
            margin-bottom: 5px
        }

        .rec-artist {
            color: rgba(255, 255, 255, .8);
            font-size: 14px
        }
    </style>
</head>

<body>
    <div class="space-background"></div>
    <div class="stars" id="stars"></div>

    <a href="https://github.com/Eoo0m" target="_blank" class="github-link">
        <svg class="github-logo" viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 
               2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 
               0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94
               -.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53
               .63-.01 1.08.58 1.23.82.72 1.21 
               1.87.87 2.33.66.07-.52.28-.87.51-1.07
               -1.78-.2-3.64-.89-3.64-3.95 
               0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 
               0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 
               1.36.09 2 .27 1.53-1.04 2.2-.82 
               2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 
               1.27.82 2.15 0 3.07-1.87 3.75-3.65 
               3.95.29.25.54.73.54 1.48 0 1.07-.01 
               1.93-.01 2.2 0 .21.15.46.55.38A8.013 
               8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        Eoo0m
    </a>

    <div class="login-screen" id="loginScreen">
        <h1>🎵 adaptive music player</h1>
        <p>동적인 음악 추천을 즐겨보세요</p>
        <button class="login-button" onclick="login()">Spotify로 로그인</button>
        <div class="error-message" id="errorMessage"></div>
    </div>

    <div class="search-interface hidden" id="initialSongInput">
        <h2>🎵 노래를 검색하고 선택하세요</h2>
        <p>검색 결과에서 곡을 선택하면 유사한 음악을 추천해드립니다.</p>
        <input type="text" class="search-input" id="initialSongTitle" placeholder="노래 제목이나 아티스트를 입력하세요...">
        <div>
            <button class="search-button" onclick="searchInitialSongs()" id="initialSearchBtn">검색</button>
        </div>
        <div id="initialSearchResults"></div>
    </div>

    <div class="track-info hidden" id="trackInfo">
        <div class="track-name" id="trackName">노래 제목</div>
        <div class="artist-name" id="artistName">아티스트</div>
        <div class="recommendation-mode" id="recMode" style="font-size:12px;opacity:.7;margin-top:5px;">🎵 AI 추천 플레이리스트
        </div>
    </div>

    <!-- ✅ 드래그 가능한 래퍼 -->
    <div id="ipodWrapper" class="ipod-wrapper">
        <div class="ipod-container" id="ipodContainer">
            <div class="clickwheel">
                <div class="control volume-up" id="volumeUp">+</div>
                <div class="control volume-down" id="volumeDown">−</div>
                <div class="control prev" id="prevBtn">‹‹</div>
                <div class="control next" id="nextBtn">››</div>
                <div class="center-button" id="centerButton">
                    <div class="play-pause" id="playPauseIcon">▶</div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://sdk.scdn.co/spotify-player.js"></script>
    <script>
        // ===== Global =====
        let player, is_paused = true, current_track = null, device_id = null;
        let access_token = null, refresh_token = null;

        let playlist = [];                // 현재 플레이리스트
        let currentTrackIndex = 0;        // 재생 인덱스

        // ===== Auth =====
        function initializeAuth() {
            const hashParams = new URLSearchParams(window.location.hash.substr(1));
            const storedToken = localStorage.getItem('spotify_access_token');
            const storedRefresh = localStorage.getItem('spotify_refresh_token');
            access_token = hashParams.get('access_token') || storedToken;
            refresh_token = hashParams.get('refresh_token') || storedRefresh;

            if (hashParams.get('error')) {
                document.getElementById('errorMessage').textContent = '로그인에 실패했습니다: ' + hashParams.get('error');
                return;
            }
            if (access_token) {
                localStorage.setItem('spotify_access_token', access_token);
                if (refresh_token) localStorage.setItem('spotify_refresh_token', refresh_token);
                document.getElementById('loginScreen').classList.add('hidden');
                document.getElementById('initialSongInput').classList.remove('hidden');
                window.location.hash = '';
            }
        }
        const API_BASE_URL = 'https://api.dynplayer.win';
        function login() { window.location.href = `${API_BASE_URL}/login`; }

        // ===== Spotify SDK =====
        window.onSpotifyWebPlaybackSDKReady = () => { if (access_token) initializeSpotifyPlayer(); };

        function initializeSpotifyPlayer() {
            if (!access_token) return;

            player = new Spotify.Player({
                name: 'Spotify iPod Web Player',
                getOAuthToken: cb => cb(access_token),
                volume: 0.5
            });

            player.addListener('initialization_error', ({ message }) => console.error('초기화 오류:', message));
            player.addListener('authentication_error', ({ message }) => { console.error('인증 오류:', message); refreshAccessToken(); });
            player.addListener('account_error', ({ message }) => { console.error('계정 오류:', message); alert('Spotify Premium 계정이 필요합니다.'); });
            player.addListener('playback_error', ({ message }) => console.error('재생 오류:', message));

            player.addListener('player_state_changed', (state) => {
                if (!state) return;
                const previousTrack = current_track;
                current_track = state.track_window.current_track;
                is_paused = state.paused;

                if (previousTrack?.id && previousTrack?.id !== current_track?.id) {
                    lastPlayedTrack = previousTrack;
                }
                if (previousTrack?.id !== current_track?.id && current_track) {
                    trackStartTime = Date.now();
                    trackDuration = current_track.duration_ms;
                }

                // 자동 종료 감지 → 다음 곡 재생
                if (state.position === 0 && state.paused && current_track) {
                    setTimeout(() => playNext(), 600);
                } else {
                    updateTrackInfo(); updatePlayPauseIcon();
                }
            });

            player.addListener('ready', ({ device_id: ready_device_id }) => {
                console.log('🎵 Spotify Player Ready with Device ID', ready_device_id);
                device_id = ready_device_id;
                transferPlaybackToDevice(device_id);
                if (isRecommendationMode && randomTracks.length > 0) setTimeout(() => playTrackAtIndex(0), 1200);
            });

            player.connect();
        }

        async function transferPlaybackToDevice(device_id) {
            try {
                await fetch('https://api.spotify.com/v1/me/player', {
                    method: 'PUT',
                    headers: { 'Authorization': `Bearer ${access_token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ device_ids: [device_id], play: false })
                });
            } catch (e) { console.error('재생 장치 전환 오류:', e); }
        }

        // ===== Debug =====
        function fmtSeed(seed) {
            if (!seed) return 'Unknown seed';
            const title = seed.name || seed.track || 'Unknown';
            const artist = (seed.artists ? seed.artists.map(a => a.name).join(', ') : seed.artist) || 'Unknown Artist';
            return `${title} — ${artist}`;
        }
        function fmtRecItem(trackObj, idx) {
            const t = trackObj.spotify_track || trackObj.track || trackObj;
            const name = t?.name || trackObj.track || 'Unknown Track';
            const artists = (t?.artists ? t.artists.map(a => a.name).join(', ') : trackObj.artist) || 'Unknown Artist';
            const sim = (trackObj.similarity ?? t?.similarity ?? null);
            const simTxt = (typeof sim === 'number') ? `  [sim=${(sim * 100).toFixed(1)}%]` : '';
            return `${String(idx + 1).padStart(2, '0')}. ${name} — ${artists}${simTxt}`;
        }
        function logRecommendationList(kind, seedTrack, list) {
            console.log(`\n📦 ${kind} RECS (n=${list.length})  |  seed: ${fmtSeed(seedTrack)}`);
            for (let i = 0; i < list.length; i++) console.log('   ' + fmtRecItem(list[i], i));
            console.log('—'.repeat(48) + '\n');
        }

        // ===== Helpers =====
        function shouldUseDiverse() {
            if (diverseLock) return false;               // 🔒 락 걸리면 금지
            if (playbackHistory.length < 3) return false;
            const last3 = playbackHistory.slice(-3);
            const avg = last3.reduce((a, b) => a + b, 0) / 3;
            return avg < 10; // 세 곡 평균 완료율 10% 미만
        }
        function getSeed() {
            if (current_track?.id) return current_track;
            if (lastPlayedTrack?.id) return lastPlayedTrack;
            const last = randomTracks[randomTracks.length - 1];
            const t = last ? (last.spotify_track || last.track || last) : null;
            return t || null;
        }

        // ===== Playback / UI =====
        async function playTrackAtIndex(index) {
            if (!randomTracks[index]) return;
            const track = randomTracks[index];
            const uri = track.uri || track.spotify_track?.uri || track.track?.uri;
            if (!uri || !device_id) return;

            const t = track.spotify_track || track.track || track;
            const name = t.name || track.track || 'Unknown Track';
            const artists = t.artists ? t.artists.map(a => a.name).join(', ') : (track.artist || 'Unknown Artist');
            const similarityText = (typeof track.similarity === 'number') ? ` (${(track.similarity * 100).toFixed(1)}% similar)` : '';
            console.log(`▶️ [${index + 1}/${randomTracks.length}] ${name} - ${artists}${similarityText}`);

            try {
                await fetch(`https://api.spotify.com/v1/me/player/play?device_id=${device_id}`, {
                    method: 'PUT',
                    headers: { 'Authorization': `Bearer ${access_token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uris: [uri] })
                });
            } catch (e) { console.error('트랙 재생 오류:', e); }
        }
        async function playSpotifyTrack(uri) {
            if (!device_id || !uri) return;
            try {
                await fetch(`https://api.spotify.com/v1/me/player/play?device_id=${device_id}`, {
                    method: 'PUT',
                    headers: { 'Authorization': `Bearer ${access_token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uris: [uri] })
                });
            } catch (e) { console.error('Spotify track playback error:', e); }
        }

        function recordTrackCompletion(reason = 'auto', currentPosition = 0) {
            if (current_track && trackStartTime && trackDuration) {
                let ratio;
                if (reason === 'manual' && currentPosition > 0) {
                    ratio = (currentPosition / trackDuration) * 100;
                } else {
                    const played = Date.now() - trackStartTime;
                    ratio = Math.min((played / trackDuration) * 100, 100);
                }
                playbackHistory.push(ratio);
                if (playbackHistory.length > maxHistoryLength) playbackHistory.shift();

                if (playbackHistory.length >= 3) {
                    const avg = playbackHistory.reduce((a, b) => a + b, 0) / playbackHistory.length;
                    console.log(`📊 Engagement: ${avg.toFixed(1)}%`);
                }

                // ✅ 다이버스 트랙을 10% 이상 들었으면 → 해당 곡 기반 유사 10곡 주입 + 락 해제
                maybeConvertDiverseToSimilar(ratio).catch(() => { });
            }
        }

        // ✅ 다이버스 → 유사 전환 로직 (Supabase 기반)
        async function maybeConvertDiverseToSimilar(ratio) {
            // 현재 인덱스의 트랙이 다이버스 태그인지 확인
            const cur = randomTracks[currentTrackIndex];
            if (!cur || !cur[DIVERSE_TAG]) return;
            if (ratio < 10) return; // 10% 미만이면 조건 불충족

            const seed = current_track || null;
            if (!seed) return;

            console.log('🟢 Diverse track listened ≥10%. Converting to SIMILAR block…');

            try {
                const title = seed?.name || '';
                const artist = seed?.artists?.[0]?.name || '';
                const query = `${title} ${artist}`.trim();

                console.log(`🔍 [Diverse→Similar] Searching for: "${query}"`);

                // 1) Supabase에서 현재 트랙 검색
                const r1 = await fetch(`${API_BASE_URL}/search-songs`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query })
                });
                if (!r1.ok) {
                    const errorText = await r1.text();
                    console.error('❌ search-songs', r1.status, errorText);
                    throw new Error('search_failed');
                }
                const d1 = await r1.json();
                const searchResults = d1.results || [];
                if (searchResults.length === 0) {
                    console.warn(`⚠️ No results found for: "${query}"`);
                    throw new Error('search_empty');
                }

                const trackKey = searchResults[0].track_key;
                console.log(`🔑 Found track_key: ${trackKey}`);

                // 2) track_key로 유사 트랙 추천
                const r2 = await fetch(`${API_BASE_URL}/recommend`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ track_key: trackKey, num_recommendations: 30 })
                });
                if (!r2.ok) throw new Error('recommend_failed');
                const d2 = await r2.json();
                const recs = d2.recommendations || [];
                if (recs.length === 0) throw new Error('recommend_empty');

                // 3) Spotify 매칭
                const r3 = await fetch(`${API_BASE_URL}/find-spotify-tracks`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tracks: recs, access_token })
                });
                if (!r3.ok) throw new Error('find_spotify_failed');
                const d3 = await r3.json();
                let newTracks = (d3.spotify_tracks || []).slice(0, 10);
                if (newTracks.length === 0) throw new Error('find_spotify_empty');

                // (중복 제거)
                const existingUris = new Set(randomTracks.map(t => (t.uri || t.spotify_track?.uri || t.track?.uri)));
                newTracks = newTracks.filter(t => !existingUris.has(t.uri || t.spotify_track?.uri || t.track?.uri));

                // 4) 현재곡 다음에 유사 10곡 끼워넣기
                const head = randomTracks.slice(0, currentTrackIndex + 1);
                const tail = randomTracks.slice(currentTrackIndex + 1);
                randomTracks = [...head, ...newTracks, ...tail];

                // 5) 모든 다이버스 태그 제거 + 락 해제
                randomTracks.forEach(t => delete t[DIVERSE_TAG]);
                diverseLock = false;

                updateRecommendationMode('similar');
                logRecommendationList('SIMILAR (after diverse)', seed, newTracks);
            } catch (e) {
                console.error('⚠️ Convert diverse→similar failed:', e?.message || e);
            }
        }

        // ===== NEXT logic =====
        async function playNextRandomTrack() {
            const seed = getSeed();
            if (!seed) { console.warn('⚠️ 시드 트랙을 찾을 수 없습니다.'); return; }

            const wantDiverse = shouldUseDiverse();

            // ===== [교체] 다이버스 조건 → 현재곡 다음에 10곡 주입 (락 걸기) =====
            if (wantDiverse && seed.id) {
                try {
                    console.log('🔴 Low engagement (<10%). Injecting 10 DIVERSE tracks after current…');

                    const diverseResp = await fetch(`${API_BASE_URL}/recommend-diverse-tracks`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ spotify_track: seed, access_token })
                    });

                    if (!diverseResp.ok) {
                        console.error('❌ recommend-diverse-tracks', diverseResp.status, await diverseResp.text());
                        throw new Error('diverse_failed');
                    }

                    const diverseData = await diverseResp.json();
                    if (diverseData.debug) console.log('[DIVERSE debug]', diverseData.debug);

                    const raw = diverseData.spotify_tracks || [];
                    console.log('[DIVERSE] server returned:', raw.length);

                    let newTracks = raw.slice(0, 12); // 넉넉히 받아서 중복 제거 후 10개로 수렴
                    if (newTracks.length === 0) {
                        console.warn('[DIVERSE] empty from server');
                        throw new Error('diverse_empty_server');
                    }

                    // 중복 제거
                    const existingUris = new Set(
                        randomTracks.map(t => (t.uri || t.spotify_track?.uri || t.track?.uri))
                    );
                    const before = newTracks.length;
                    newTracks = newTracks.filter(t => !existingUris.has(t.uri || t.spotify_track?.uri || t.track?.uri));
                    console.log('[DIVERSE] dedup:', before, '→', newTracks.length);

                    if (newTracks.length === 0) {
                        console.warn('[DIVERSE] all deduped; fallback to SIMILAR');
                        await fetchAndInjectSimilarAfterCurrent(seed);
                        return;
                    }

                    // ✅ 다이버스 태그 + 락
                    newTracks = newTracks.slice(0, 10);
                    newTracks.forEach(t => t[DIVERSE_TAG] = true);
                    diverseLock = true;

                    // 현재곡 다음에 삽입
                    const head = randomTracks.slice(0, currentTrackIndex + 1);
                    const tail = randomTracks.slice(currentTrackIndex + 1);
                    randomTracks = [...head, ...newTracks, ...tail];

                    updateRecommendationMode('diverse');
                    logRecommendationList('DIVERSE (injected)', seed, newTracks);

                    // 방금 끼운 첫 곡 재생
                    currentTrackIndex++;
                    await playTrackAtIndex(currentTrackIndex);
                    return;

                } catch (e) {
                    console.error('⚠️ Diverse injection failed:', e?.message || e);
                    // 실패 시 아래 일반 로직으로 폴백
                }
            }

            // 2) 평상시: 다음 곡이 남아있으면 진행
            if (isRecommendationMode && randomTracks.length > 0 && currentTrackIndex < randomTracks.length - 1) {
                currentTrackIndex++;
                await playTrackAtIndex(currentTrackIndex);
                return;
            }

            // 3) 리스트가 끝났거나 비어있으면: Supabase에서 유사 추천으로 새 10곡 구성
            try {
                console.log('🟢 Requesting SIMILAR from Supabase…');

                // ✅ 현재 트랙의 track_key 먼저 확인
                const currentTrack = randomTracks[currentTrackIndex];
                let trackKey = currentTrack?.track_key;

                // track_key가 없으면 검색으로 찾기
                if (!trackKey) {
                    const title = seed?.name || '';
                    const artist = seed?.artists?.[0]?.name || '';
                    const query = `${title} ${artist}`.trim();

                    console.log(`🔍 No track_key found, searching Supabase for: "${query}"`);

                    const r1 = await fetch(`${API_BASE_URL}/search-songs`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ query })
                    });
                    if (!r1.ok) {
                        const errorText = await r1.text();
                        console.error('❌ search-songs', r1.status, errorText);
                        throw new Error('search_failed');
                    }
                    const d1 = await r1.json();
                    const searchResults = d1.results || [];

                    if (searchResults.length === 0) {
                        console.warn(`⚠️ No results found in Supabase for: "${query}"`);
                        console.warn('💡 This track may not exist in the database. Try playing a different song.');
                        throw new Error('search_empty');
                    }

                    trackKey = searchResults[0].track_key;
                    console.log(`🔑 Found track_key via search: ${trackKey} (${searchResults[0].track} - ${searchResults[0].artist})`);
                } else {
                    console.log(`🔑 Using stored track_key: ${trackKey}`);
                }

                // 2) track_key로 유사 트랙 추천
                const r2 = await fetch(`${API_BASE_URL}/recommend`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ track_key: trackKey, num_recommendations: 30 })
                });
                if (!r2.ok) {
                    const errorText = await r2.text();
                    console.error('❌ recommend', r2.status, errorText);
                    throw new Error('recommend_failed');
                }
                const d2 = await r2.json();
                const recs = d2.recommendations || [];
                if (recs.length === 0) throw new Error('recommend_empty');

                // 3) Spotify 매칭
                const r3 = await fetch(`${API_BASE_URL}/find-spotify-tracks`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tracks: recs, access_token })
                });
                if (!r3.ok) { console.error('❌ find-spotify-tracks', r3.status); throw new Error('find_spotify_failed'); }
                const d3 = await r3.json();
                const spts = d3.spotify_tracks || [];
                if (spts.length === 0) throw new Error('find_spotify_empty');

                randomTracks = spts.slice(0, 10);
                currentTrackIndex = 0;
                isRecommendationMode = true;

                // 혹시 남아있던 태그/락 초기화
                randomTracks.forEach(t => delete t[DIVERSE_TAG]);
                diverseLock = false;

                updateRecommendationMode('similar');
                logRecommendationList('SIMILAR', seed, randomTracks);

                await playSpotifyTrack(randomTracks[0].uri || randomTracks[0].track?.uri);
                console.log(`🟢 SIMILAR playlist loaded: ${randomTracks.length} tracks`);
            } catch (e) {
                console.error('⚠️ Similar fetch failed:', e?.message || e);
            }
        }

        async function playPreviousRandomTrack() {
            let pos = 0;
            if (player) { try { const st = await player.getCurrentState(); pos = st ? st.position : 0; } catch { } }
            recordTrackCompletion('manual', pos);

            if (randomTracks.length === 0) return;
            currentTrackIndex = currentTrackIndex === 0 ? randomTracks.length - 1 : currentTrackIndex - 1;
            await playTrackAtIndex(currentTrackIndex);
        }

        async function refreshAccessToken() {
            if (!refresh_token) { logout(); return; }
            try {
                const r = await fetch('/refresh_token', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ refresh_token }) });
                const d = await r.json();
                if (d.access_token) {
                    access_token = d.access_token; localStorage.setItem('spotify_access_token', access_token);
                    if (d.refresh_token) { refresh_token = d.refresh_token; localStorage.setItem('spotify_refresh_token', refresh_token); }
                } else { logout(); }
            } catch (e) { console.error('토큰 새로고침 오류:', e); logout(); }
        }
        function logout() {
            localStorage.removeItem('spotify_access_token');
            localStorage.removeItem('spotify_refresh_token');
            access_token = null; refresh_token = null;
            if (player) player.disconnect();
            document.getElementById('loginScreen').classList.remove('hidden');
            document.getElementById('trackInfo').classList.add('hidden');
        }

        // ===== UI =====
        function updateTrackInfo() {
            if (!current_track) return;
            document.getElementById('trackName').textContent = current_track.name;
            document.getElementById('artistName').textContent = current_track.artists.map(a => a.name).join(', ');
            document.getElementById('trackInfo').classList.remove('hidden');
            updateMediaSession();
        }
        function updateMediaSession() {
            if (!('mediaSession' in navigator) || !current_track) return;
            navigator.mediaSession.metadata = new MediaMetadata({
                title: current_track.name,
                artist: current_track.artists.map(a => a.name).join(', '),
                album: current_track.album?.name || 'Unknown Album',
                artwork: current_track.album?.images?.map(img => ({ src: img.url, sizes: `${img.width}x${img.height}`, type: 'image/jpeg' })) || []
            });
            navigator.mediaSession.setActionHandler('play', async () => { await togglePlayPause(); });
            navigator.mediaSession.setActionHandler('pause', async () => { await togglePlayPause(); });
            navigator.mediaSession.setActionHandler('previoustrack', async () => { await playPreviousRandomTrack(); });
            navigator.mediaSession.setActionHandler('nexttrack', async () => { await onNextPressed(); });
            navigator.mediaSession.playbackState = is_paused ? 'paused' : 'playing';
        }
        function updatePlayPauseIcon() {
            document.getElementById('playPauseIcon').textContent = is_paused ? '▶' : '‖';
            if ('mediaSession' in navigator) navigator.mediaSession.playbackState = is_paused ? 'paused' : 'playing';
        }
        function updateIPodState() {
            const el = document.getElementById('ipodContainer');
            if (!is_paused) el.classList.add('playing'); else el.classList.remove('playing');
        }
        function updateRecommendationMode(mode) {
            const el = document.getElementById('ipodContainer');
            el.classList.remove('similar-mode', 'diverse-mode');
            if (mode === 'similar') el.classList.add('similar-mode');
            if (mode === 'diverse') el.classList.add('diverse-mode');
            setTimeout(() => { el.classList.remove('similar-mode', 'diverse-mode'); }, 3000);
        }
        async function togglePlayPause() { if (player) await player.togglePlay(); }
        async function adjustVolume(delta) {
            if (!player) return;
            try {
                const state = await player.getCurrentState();
                if (state) {
                    const newV = Math.max(0, Math.min(1, state.volume + delta));
                    await player.setVolume(newV);
                    const control = delta > 0 ? document.getElementById('volumeUp') : document.getElementById('volumeDown');
                    control.classList.add('active'); setTimeout(() => control.classList.remove('active'), 200);
                }
            } catch (e) { console.error('볼륨 조절 오류:', e); }
        }

        // ===== 초기 추천 =====
        // ✅ 검색 결과에서 선택한 곡으로 시작 (track_key 기반)
        async function startRecommendationPlaylist(selectedTrack) {
            if (!selectedTrack || !selectedTrack.track_key) {
                alert('먼저 노래를 검색하고 선택해주세요.');
                return;
            }

            console.log('🎵 Starting playlist with track_key:', selectedTrack.track_key);

            try {
                const r = await fetch(`${API_BASE_URL}/recommend`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        track_key: selectedTrack.track_key,
                        num_recommendations: 30
                    })
                });
                const d = await r.json();
                if (d.error) {
                    alert(d.error);
                }
                else if (d.recommendations?.length > 0) {
                    await setupInitialPlaylist(d.recommendations, selectedTrack);
                }
                else {
                    alert('추천곡을 찾을 수 없습니다. 다른 노래를 시도해보세요.');
                }
            } catch (e) {
                console.error('Initial recommendation error:', e);
                alert('추천 시스템에 연결할 수 없습니다.');
            }
        }
        async function setupInitialPlaylist(recommendations, originalSong) {
            try {
                console.log(`🎵 Setting up initial playlist with ${recommendations.length} recommendations`);
                console.log('Original song:', originalSong);

                // recommendations에 track_key가 있는지 확인
                const hasTrackKeys = recommendations.every(r => r.track_key || r.track?.track_key);
                console.log(`Track keys present: ${hasTrackKeys}`);

                const r = await fetch(`${API_BASE_URL}/find-spotify-tracks`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tracks: recommendations, access_token })
                });
                if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`);
                const d = await r.json();

                if (d.spotify_tracks?.length > 0) {
                    randomTracks = d.spotify_tracks.slice(0, 10);
                    currentTrackIndex = 0;
                    isRecommendationMode = true;
                    playbackHistory = [];

                    // 초기화
                    randomTracks.forEach(t => delete t[DIVERSE_TAG]);
                    diverseLock = false;

                    // ✅ track_key를 각 트랙에 저장
                    randomTracks.forEach((track, idx) => {
                        if (!track.track_key && recommendations[idx]?.track_key) {
                            track.track_key = recommendations[idx].track_key;
                        }
                    });

                    updateRecommendationMode('similar');
                    logRecommendationList('SIMILAR', originalSong, randomTracks);

                    console.log(`🎵 Initial playlist created: ${randomTracks.length} tracks`);
                    document.getElementById('initialSongInput').classList.add('hidden');
                    document.getElementById('trackInfo').classList.remove('hidden');

                    if (!player) initializeSpotifyPlayer(); else playTrackAtIndex(0);
                } else {
                    alert('Spotify에서 추천곡들을 찾을 수 없습니다. 다른 노래를 시도해보세요.');
                }
            } catch (e) {
                console.error('Error setting up playlist:', e);
                alert('플레이리스트 생성 중 오류: ' + e.message);
            }
        }

        async function searchInitialSongs() {
            const query = document.getElementById('initialSongTitle').value.trim();
            if (!query) { alert('검색어를 입력해주세요.'); return; }
            const btn = document.getElementById('initialSearchBtn');
            btn.disabled = true; btn.textContent = '검색 중...';
            try {
                const r = await fetch(`${API_BASE_URL}/search-songs`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query })
                });
                const d = await r.json();
                if (d.error) { document.getElementById('initialSearchResults').innerHTML = `<div class="error-message">${d.error}</div>`; }
                else { displayInitialSearchResults(d.results); }
            } catch (e) {
                console.error('Initial search error:', e);
                document.getElementById('initialSearchResults').innerHTML = '<div class="error-message">검색 서비스에 연결할 수 없습니다.</div>';
            } finally { btn.disabled = false; btn.textContent = '검색'; }
        }
        function displayInitialSearchResults(results) {
            const div = document.getElementById('initialSearchResults');
            if (results.length === 0) {
                div.innerHTML = '<div class="error-message">검색 결과가 없습니다.</div>';
                return;
            }
            let html = '<div class="recommendation-list" style="max-height:200px;">';
            results.slice(0, 10).forEach((r, idx) => {
                html += `
          <div class="recommendation-item" data-track-idx="${idx}">
            <div class="rec-title">${r.track}</div>
            <div class="rec-artist">${r.artist} - ${r.album}</div>
          </div>`;
            });
            html += '</div>';
            div.innerHTML = html;

            // Attach click listeners with proper data
            results.slice(0, 10).forEach((r, idx) => {
                const elem = div.querySelector(`[data-track-idx="${idx}"]`);
                if (elem) {
                    elem.onclick = () => selectAndStartPlaylist({
                        track_key: r.track_key,
                        track: r.track,
                        artist: r.artist,
                        album: r.album
                    });
                }
            });
        }

        // ✅ 검색 결과에서 곡 선택 시 바로 재생 시작
        async function selectAndStartPlaylist(trackData) {
            console.log('Selected track:', trackData);
            console.log('Track key being passed:', trackData.track_key);
            document.getElementById('initialSearchResults').innerHTML = '';
            document.getElementById('initialSongTitle').value = `${trackData.track} - ${trackData.artist}`;

            // 바로 추천 플레이리스트 시작
            await startRecommendationPlaylist(trackData);
        }

        // ===== Controls =====
        document.getElementById('centerButton').addEventListener('click', async () => { await togglePlayPause(); });

        async function onNextPressed() {
            console.log('🔴 Next button clicked!');
            let pos = 0;
            if (player) { try { const st = await player.getCurrentState(); pos = st ? st.position : 0; } catch { } }
            recordTrackCompletion('manual', pos);
            await playNextRandomTrack();
        }
        document.getElementById('nextBtn').addEventListener('click', onNextPressed);
        document.getElementById('prevBtn').addEventListener('click', async () => { await playPreviousRandomTrack(); });
        document.getElementById('volumeUp').addEventListener('click', () => adjustVolume(0.1));
        document.getElementById('volumeDown').addEventListener('click', () => adjustVolume(-0.1));

        // 엔터로 검색
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('initialSongTitle').addEventListener('keypress', e => {
                if (e.key === 'Enter') searchInitialSongs();
            });
        });

        // 디버그
        function showPlaylistStatus() {
            if (randomTracks.length === 0) { console.log('🚫 No playlist loaded'); return; }
            console.log(`\n📊 ===== PLAYLIST STATUS =====`);
            console.log(`📍 Position: ${currentTrackIndex + 1}/${randomTracks.length}`);
            console.log(`🎵 Current: ${current_track?.name || 'None'} - ${current_track?.artists?.map(a => a.name).join(', ') || 'Unknown'}`);
            console.log(`📋 Remaining: ${randomTracks.length - currentTrackIndex - 1}`);
            console.log(`🔒 Diverse lock: ${diverseLock ? 'ON' : 'OFF'}`);
            const leftTags = randomTracks.filter(t => t[DIVERSE_TAG]).length;
            console.log(`🏷️ Diverse-tagged remaining: ${leftTags}`);
            console.log(`📊 History: ${playbackHistory.length} entries`);
            if (playbackHistory.length > 0) { const avg = playbackHistory.reduce((a, b) => a + b, 0) / playbackHistory.length; console.log(`📊 Avg completion: ${avg.toFixed(1)}%`); }
            console.log(`============================\n`);
        }
        window.showPlaylistStatus = showPlaylistStatus;

        // ===== 배경 비주얼 =====
        function createStars() {
            const box = document.getElementById('stars');
            for (let i = 0; i < 200; i++) {
                const s = document.createElement('div'); s.className = 'star';
                const sizes = ['small', 'medium', 'large']; s.classList.add(sizes[Math.floor(Math.random() * sizes.length)]);
                s.style.left = Math.random() * 100 + '%'; s.style.top = Math.random() * 100 + '%';
                s.style.animationDelay = Math.random() * 2 + 's'; s.style.animationDuration = (1 + Math.random() * 2) + 's';
                box.appendChild(s);
            }
        }
        function createDust() {
            const d = document.createElement('div'); d.className = 'dust';
            d.style.left = Math.random() * 100 + '%'; d.style.width = d.style.height = Math.random() * 3 + 1 + 'px';
            d.style.animationDuration = (8 + Math.random() * 4) + 's'; d.style.animationDelay = Math.random() * 2 + 's';
            document.body.appendChild(d); setTimeout(() => d.remove(), 12000);
        }

        // ===== ✅ 아이팟 드래그 =====
        (function enableIPodDrag() {
            const wrap = document.getElementById('ipodWrapper');
            let dragging = false, startX = 0, startY = 0, startLeft = 0, startTop = 0;

            function onDown(e) {
                dragging = true; wrap.classList.add('dragging');
                const rect = wrap.getBoundingClientRect();
                startLeft = rect.left; startTop = rect.top;
                if (e.touches && e.touches[0]) { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }
                else { startX = e.clientX; startY = e.clientY; }
                e.preventDefault();
            }
            function onMove(e) {
                if (!dragging) return;
                const x = e.touches && e.touches[0] ? e.touches[0].clientX : e.clientX;
                const y = e.touches && e.touches[0] ? e.touches[0].clientY : e.clientY;
                const dx = x - startX; const dy = y - startY;
                let left = startLeft + dx; let top = startTop + dy;

                // 화면 밖으로 못나가게 클램프
                const W = window.innerWidth, H = window.innerHeight;
                const w = wrap.offsetWidth, h = wrap.offsetHeight;
                left = Math.max(0, Math.min(W - w, left));
                top = Math.max(0, Math.min(H - h, top));

                wrap.style.left = left + 'px';
                wrap.style.top = top + 'px';
            }
            function onUp() {
                dragging = false; wrap.classList.remove('dragging');
            }

            wrap.addEventListener('mousedown', onDown);
            wrap.addEventListener('touchstart', onDown, { passive: false });
            window.addEventListener('mousemove', onMove, { passive: false });
            window.addEventListener('touchmove', onMove, { passive: false });
            window.addEventListener('mouseup', onUp);
            window.addEventListener('touchend', onUp);
        })();

        // ===== 초기화 =====
        createStars(); setInterval(createDust, 2000); initializeAuth();
    </script>
</body>

</html>